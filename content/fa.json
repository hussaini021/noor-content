    "active": true
  },
  {
    "id": "quran-002-155-12",
    "type": "quran",
    "category": "patience",
    "title": "",
    "text": "و به شکیبایان مژده بده.",
    "arabic": "وَبَشِّرِ الصَّابِرِينَ",
