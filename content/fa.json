    "surahNumber": 2,
    "ayahNumber": 155,
    "publishedAt": "2026-10-09",
    "active": true
  },
  {
    "id": "quran-003-173-13",
    "type": "quran",
    "category": "trust",
    "title": "",
    "text": "الله ما را بس است و چه نیکو کارسازی است.",
    "arabic": "حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ",
