    "reference": "حدید، ۵۷:۴ (بخشی از آیه)",
    "surahNumber": 57,
    "ayahNumber": 4,
    "publishedAt": "2026-10-09",
    "active": true
  },
  {
    "id": "quran-011-061-17",
    "type": "quran",
    "category": "hope",
    "title": "",
    "text": "بی‌گمان پروردگارم نزدیک و اجابت‌کننده است.",
    "arabic": "إِنَّ رَبِّي قَرِيبٌ مُّجِيبٌ",
    "reference": "هود، ۱۱:۶۱ (بخشی از آیه)",
    "surahNumber": 11,
    "ayahNumber": 61,
    "publishedAt": "2026-10-09",
    "active": true
  },
  {
    "id": "quran-070-005-18",
    "type": "quran",
    "category": "patience",
    "title": "",
    "text": "پس صبری نیکو پیشه کن.",
    "arabic": "فَاصْبِرْ صَبْرًا جَمِيلًا",
    "reference": "معارج، ۷۰:۵",
    "surahNumber": 70,
    "ayahNumber": 5,
    "publishedAt": "2026-10-09",
    "active": true
  },
  {
    "id": "quran-002-237-19",
    "type": "quran",
    "category": "kindness",
    "title": "",
    "text": "و نیکی و بزرگواری میان خود را فراموش نکنید.",
    "arabic": "وَلَا تَنسَوُا الْفَضْلَ بَيْنَكُمْ",
    "reference": "بقره، ۲:۲۳۷ (بخشی از آیه)",
    "surahNumber": 2,
    "ayahNumber": 237,
    "publishedAt": "2026-10-09",
    "active": true
  },
  {
    "id": "quran-094-008-20",
    "type": "quran",
    "category": "trust",
    "title": "",
    "text": "و تنها به سوی پروردگارت رغبت کن.",
    "arabic": "وَإِلَىٰ رَبِّكَ فَارْغَب",
    "reference": "شرح، ۹۴:۸",
    "surahNumber": 94,
    "ayahNumber": 8,
    "publishedAt": "2026-10-09",
    "active": true
  },
  {
    "id": "hadith-001",
    "type": "hadith",
    "category": "kindness",
    "title": "",
    "text": "ارزش اعمال به نیت‌ها بستگی دارد.",
    "arabic": "إِنَّمَا الْأَعْمَالُ بِالنِّيَّاتِ",
    "reference": "صحیح بخاری، حدیث ۱",
    "publishedAt": "2026-10-09",
    "active": true
  },
  {
    "id": "hadith-002",
    "type": "hadith",
    "category": "kindness",
    "title": "",
    "text": "سخن نیک صدقه است.",
    "arabic": "الْكَلِمَةُ الطَّيِّبَةُ صَدَقَةٌ",
    "reference": "صحیح بخاری و صحیح مسلم",
    "publishedAt": "2026-10-09",
    "active": true
  },
  {
    "id": "hadith-003",
    "type": "hadith",
    "category": "kindness",
    "title": "",
    "text": "دین خیرخواهی است.",
    "arabic": "الدِّينُ النَّصِيحَةُ",
    "reference": "صحیح مسلم",
    "publishedAt": "2026-10-09",
    "active": true
  },
  {
    "id": "hadith-004",
    "type": "hadith",
    "category": "mercy",
    "title": "",
    "text": "کسی که رحم نکند، بر او رحم نمی‌شود.",
    "arabic": "مَنْ لَا يَرْحَمْ لَا يُرْحَمْ",
    "reference": "صحیح بخاری و صحیح مسلم",
    "publishedAt": "2026-10-09",
    "active": true
  },
  {
    "id": "hadith-005",
    "type": "hadith",
    "category": "kindness",
    "title": "",
    "text": "خشم مگیر.",
    "arabic": "لَا تَغْضَبْ",
    "reference": "صحیح بخاری",
    "publishedAt": "2026-10-09",
    "active": true
  },
  {
    "id": "hadith-006",
    "type": "hadith",
    "category": "kindness",
    "title": "",
    "text": "آسان بگیرید و سخت‌گیری نکنید.",
    "arabic": "يَسِّرُوا وَلَا تُعَسِّرُوا",
    "reference": "صحیح بخاری و صحیح مسلم",
    "publishedAt": "2026-10-09",
    "active": true
  },
  {
    "id": "hadith-007",
    "type": "hadith",
    "category": "kindness",
    "title": "",
    "text": "مژده دهید و مردم را گریزان نکنید.",
    "arabic": "بَشِّرُوا وَلَا تُنَفِّرُوا",
    "reference": "صحیح بخاری و صحیح مسلم",
    "publishedAt": "2026-10-09",
    "active": true
  },
  {
    "id": "hadith-008",
    "type": "hadith",
    "category": "kindness",
    "title": "",
    "text": "هرکه ما را فریب دهد از ما نیست.",
    "arabic": "مَنْ غَشَّنَا فَلَيْسَ مِنَّا",
    "reference": "صحیح مسلم",
    "publishedAt": "2026-10-09",
    "active": true
  },
  {
    "id": "hadith-009",
    "type": "hadith",
    "category": "kindness",
    "title": "",
    "text": "حیا شاخه‌ای از ایمان است.",
    "arabic": "الْحَيَاءُ شُعْبَةٌ مِنَ الْإِيمَانِ",
    "reference": "صحیح بخاری و صحیح مسلم",
    "publishedAt": "2026-10-09",
    "active": true
  },
  {
    "id": "hadith-010",
    "type": "hadith",
    "category": "gratitude",
    "title": "",
    "text": "پاکیزگی نیمی از ایمان است.",
    "arabic": "الطُّهُورُ شَطْرُ الْإِيمَانِ",
    "reference": "صحیح مسلم",
    "publishedAt": "2026-10-09",
    "active": true
  },
  {
    "id": "hadith-011",
    "type": "hadith",
    "category": "gratitude",
    "title": "",
    "text": "الحمدلله میزان را پر می‌کند.",
    "arabic": "الْحَمْدُ لِلَّهِ تَمْلَأُ الْمِيزَانَ",
    "reference": "صحیح مسلم",
    "publishedAt": "2026-10-09",
    "active": true
  },
  {
    "id": "hadith-012",
    "type": "hadith",
    "category": "kindness",
    "title": "",
    "text": "لبخندت به روی برادرت برای تو صدقه است.",
    "arabic": "تَبَسُّمُكَ فِي وَجْهِ أَخِيكَ لَكَ صَدَقَةٌ",
    "reference": "سنن ترمذی",
    "publishedAt": "2026-10-09",
    "active": true
  },
  {
    "id": "hadith-013",
    "type": "hadith",
    "category": "kindness",
    "title": "",
    "text": "هرکه به کار نیکی راهنمایی کند، پاداشی مانند انجام‌دهنده آن دارد.",
    "arabic": "مَنْ دَلَّ عَلَى خَيْرٍ فَلَهُ مِثْلُ أَجْرِ فَاعِلِهِ",
    "reference": "صحیح مسلم",
    "publishedAt": "2026-10-09",
    "active": true
  },
  {
    "id": "hadith-014",
    "type": "hadith",
    "category": "patience",
    "title": "",
    "text": "صبر روشنایی است.",
    "arabic": "الصَّبْرُ ضِيَاءٌ",
    "reference": "صحیح مسلم",
    "publishedAt": "2026-10-09",
    "active": true
  },
  {
    "id": "hadith-015",
    "type": "hadith",
    "category": "kindness",
    "title": "",
    "text": "نیکوکاری، خوش‌اخلاقی است.",
    "arabic": "الْبِرُّ حُسْنُ الْخُلُقِ",
    "reference": "صحیح مسلم",
    "publishedAt": "2026-10-09",
    "active": true
  },
  {
    "id": "hadith-016",
    "type": "hadith",
    "category": "kindness",
    "title": "",
    "text": "سخن‌چین وارد بهشت نمی‌شود.",
    "arabic": "لَا يَدْخُلُ الْجَنَّةَ نَمَّامٌ",
    "reference": "صحیح بخاری و صحیح مسلم",
    "publishedAt": "2026-10-09",
    "active": true
  },
  {
    "id": "hadith-017",
    "type": "hadith",
    "category": "kindness",
    "title": "",
    "text": "هرکه سکوت کند، نجات می‌یابد.",
    "arabic": "مَنْ صَمَتَ نَجَا",
    "reference": "سنن ترمذی؛ درجه روایت نیازمند بررسی",
    "publishedAt": "2026-10-09",
    "active": true
  },
  {
    "id": "hadith-018",
    "type": "hadith",
    "category": "kindness",
    "title": "",
    "text": "مسلمان برادر مسلمان است.",
    "arabic": "الْمُسْلِمُ أَخُو الْمُسْلِمِ",
    "reference": "صحیح بخاری و صحیح مسلم",
    "publishedAt": "2026-10-09",
    "active": true
  },
  {
    "id": "hadith-019",
    "type": "hadith",
    "category": "kindness",
    "title": "",
    "text": "به یکدیگر حسد نورزید.",
    "arabic": "لَا تَحَاسَدُوا",
    "reference": "صحیح مسلم (بخشی از حدیث)",
    "publishedAt": "2026-10-09",
    "active": true
  },
  {
    "id": "hadith-020",
    "type": "hadith",
    "category": "mercy",
    "title": "",
    "text": "مهربانان را خدای رحمان مورد رحمت قرار می‌دهد.",
    "arabic": "الرَّاحِمُونَ يَرْحَمُهُمُ الرَّحْمَنُ",
    "reference": "سنن ابوداود و ترمذی",
    "publishedAt": "2026-10-09",
    "active": true
  },
  {
    "id": "story-original-001",
    "type": "story",
    "category": "hope",
    "title": "چراغ قدم بعدی",
    "text": "مسافری در شب تاریک چراغ کوچکی روشن کرد. نور آن تا انتهای راه نمی‌رسید، اما قدم بعدی را نشان می‌داد. او فهمید که برای آغازکردن، لازم نیست تمام مسیر روشن باشد.",
    "reference": "داستان کوتاه تألیفی؛ روایت تاریخی یا حدیث نیست",
    "publishedAt": "2026-10-09",
    "active": true
  },
  {
    "id": "story-original-002",
    "type": "story",
    "category": "patience",
    "title": "دانه زیر خاک",
    "text": "باغبان هر روز به خاک گلدان نگاه می‌کرد و نشانی از جوانه نمی‌دید. با این‌همه آب‌دادن را ادامه داد. روزی جوانه‌ای کوچک سر برآورد و به او یاد داد که رشد همیشه از چشم پنهان است.",
    "reference": "داستان کوتاه تألیفی؛ روایت تاریخی یا حدیث نیست",
    "publishedAt": "2026-10-09",
    "active": true
  },
  {
    "id": "story-original-003",
    "type": "story",
    "category": "peace",
    "title": "یک دقیقه سکوت",
    "text": "دانشجویی در میان کارهای فراوان، برای یک دقیقه از صفحه تلفن فاصله گرفت. آرام نشست و نفس کشید. مشکلات ناپدید نشدند، اما ذهنش برای برداشتن نخستین قدم روشن‌تر شد.",
    "reference": "داستان کوتاه تألیفی؛ روایت تاریخی یا حدیث نیست",
    "publishedAt": "2026-10-09",
    "active": true
  },
  {
    "id": "story-original-004",
    "type": "story",
