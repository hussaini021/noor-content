    "publishedAt": "2026-10-09",
    "active": true
  },
  {
    "id": "quran-014-007-07",
    "type": "quran",
    "category": "gratitude",
    "title": "",
    "text": "اگر سپاسگزاری کنید، حتماً بر شما می‌افزایم.",
