    "active": true
  },
  {
    "id": "quran-002-195-14",
    "type": "quran",
    "category": "kindness",
    "title": "",
    "text": "بی‌گمان الله نیکوکاران را دوست دارد.",
    "arabic": "إِنَّ اللَّهَ يُحِبُّ الْمُحْسِنِينَ",
