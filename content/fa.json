    "surahNumber": 2,
    "ayahNumber": 83,
    "publishedAt": "2026-10-09",
    "active": true
  },
  {
    "id": "quran-007-156-09",
    "type": "quran",
    "category": "mercy",
    "title": "",
    "text": "و رحمت من همه‌چیز را فرا گرفته است.",
